@page
@model ShoppingCart.Pages.Checkout.ConfirmationModel

@{
    ViewData["Title"] = "Tak for din ordre";
}
<div class="card text-center mt-5" style="max-width: 600px; margin: 3rem auto; padding: 3rem;">
    <h1 class="text-success" style="margin-bottom: 1rem;">Tak for din ordre!</h1>
    <p class="lead" style="margin-bottom: 2rem;">Din bestilling er modtaget, og vi har sendt en bekræftelse til din e-mail.</p>
    <a href="/" class="btn btn-primary">Tilbage til forsiden</a>
</div>