@page
@model IndexModel
@{
    ViewData["Title"] = "Webshop";
}
@using System.Security.Claims;
@* <p>Er brugeren logget ind? @User.Identity.IsAuthenticated</p>
<p>Bruger-ID: @User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</p> *@

<div class="product-container mt-4">
    <h1 class="mb-3">Produkter</h1>
    <div class="product-grid">
        @foreach (var prod in Model.Products)
        {
            <div class="product-card">
                <div class="product-info">
                    <h3>@prod.ProductName</h3>
                    <p class="product-price">@prod.Price.ToString("C")</p>
                </div>
                <form method="post" asp-page-handler="AddToCart">
                    <input type="hidden" name="ProductId" value="@prod.ProductId" />
                    <button type="submit" class="btn btn-success" style="width: 100%;">Læg i kurv</button>
                </form>
            </div>
        }
    </div>
</div>