@page
@model ShoppingCart.Pages.CartModel
@{
    ViewData["Title"] = "Din indkøbskurv";
}

<div class="card">
    <h2 class="cart-title">Din indkøbskurv</h2>

    @if (Model.Cart.CartItems == null || !Model.Cart.CartItems.Any())
    {
        <p class="lead">Din kurv er tom.</p>
        <p class="mt-3"><a href="/Index" class="btn btn-primary">Fortsæt med at handle</a></p>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th>Stykpris</th>
                    <th>Antal</th>
                    <th>Subtotal</th>
                    <th>Handling</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Cart.CartItems)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("0.00") kr.</td>
                        <td>
                            <span class="cart-item-quantity">@item.Quantity</span>
                        </td>
                        <td>@((item.Price * item.Quantity).ToString("0.00")) kr.</td>
                        <td>
                            <div class="cart-action-group">
                                <form method="post" asp-page-handler="RemoveItem">
                                    <input type="hidden" name="CartItemId" value="@item.Id" />
                                    <button type="submit" class="btn-cart-qty btn-cart-remove">-</button>
                                </form>
                                <form method="post" asp-page-handler="AddItem">
                                    <input type="hidden" name="CartItemId" value="@item.Id" />
                                    <button type="submit" class="btn-cart-qty btn-cart-add">+</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4 cart-total-section">
            <h3>Total pris: @Model.Cart.TotalPrice.ToString("0.00") kr.</h3>
        </div>

        <div class="mt-4">
            <a href="/Checkout/Step1" class="btn btn-success">
                Tjek-ud
            </a>
        </div>
    }
</div>