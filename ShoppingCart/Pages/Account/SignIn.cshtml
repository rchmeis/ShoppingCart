@page
@model ShoppingCart.Pages.Account.SignInModel
@{
    ViewData["Title"] = "Log ind";
}
<div class="card" style="max-width: 450px; margin: 3rem auto; padding: 2.5rem;">
    <h2 style="margin-bottom: 1.5rem; text-align: center;">Log ind</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" style="margin-bottom: 1.5rem;">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label asp-for="Username" class="form-label">Brugernavn</label>
            <input asp-for="Username" class="form-control" required autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label">Adgangskode</label>
            <input asp-for="Password" type="password" class="form-control" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Log ind</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">
        <p class="text-muted">Har du ikke en konto? <a href="/Account/SignUp" style="color: var(--primary-color); font-weight: 600; text-decoration: none;">Opret en her</a></p>
    </div>
</div>